    "version": "0.2.0",
    "configurations": [
        {
            "name": "SE_Run Debug",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Build/CoreLibrary/Source/SE_Run.exe",
            "args": [ "--application", "SEEditor", "--project", "TestProject", "--res_x", "2900", "--res_y", "1350" ],
            "cwd": "c:/work/TestProject",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "internalConsoleOptions": "openOnSessionStart"
        },
        {
            "name": "SE_Material Debug",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Build/CoreLibrary/Programs/TestMaterialSystem/TestNewMaterials.exe",
            "args": [  ],
            "cwd": "D:/Personal/Projects/TestProject",
            "stopAtEntry": false
        },
        {
            "name": "SE_Test Debug",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Build/Tests/lste_cuda_test.exe",
            "cwd": "${workspaceFolder}/Programs/TestProject",
            "stopAtEntry": false
        }
    ]
}